# Copie para .env e ajuste. Nada aqui é segredo real.

# Papel doce_api (a API). Em produção, a URL do pooler do banco.
DATABASE_URL=postgresql+psycopg://doce_api:doce_api_local@localhost:5432/doce
# Dono do schema, usado só pelo alembic e por scripts.preparar_banco.
MIGRATIONS_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/doce
DOCE_API_SENHA=doce_api_local

# Autenticação do painel. Produção: Supabase Auth (valida o JWT pelas chaves públicas).
# SUPABASE_URL=<URL do projeto, no painel do Supabase>
# Desenvolvimento local, sem Supabase: JWT HS256 com este segredo (use 32 bytes ou mais).
JWT_SECRET=segredo-local-so-para-desenvolvimento-32b

# Mapa: "fake" não usa rede (CEP 12345-678 a 5 km). Sem isso, usa BrasilAPI + Google Maps.
ROTEADOR=fake
# GOOGLE_MAPS_API_KEY=

# Origens permitidas no CORS (separadas por vírgula). Vazio: sem CORS.
CORS_ORIGENS=http://localhost:5173

# Testes de integração: um Postgres onde se pode criar banco.
TEST_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
