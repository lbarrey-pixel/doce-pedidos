# Copie para .env.local. Em desenvolvimento, /api é encaminhado ao backend (porta 8000).

# Painel sem Supabase: cole aqui o JWT gerado por `python -m scripts.token_dev` (backend).
VITE_DEV_TOKEN=

# Painel com Supabase Auth (produção). A chave publicável é pública por desenho.
# VITE_SUPABASE_URL=<URL do projeto, no painel do Supabase>
# VITE_SUPABASE_PUBLISHABLE_KEY=

# URL da API quando o frontend é publicado separado do backend (vazio: mesma origem).
# VITE_API_URL=
